<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required so Secure Enclave key creation is permitted: unsigned/plain
       swift-run binaries hit errSecMissingEntitlement (-34018) because they
       have no keychain access-group entitlement. -->
  <key>com.apple.security.app-sandbox</key>
  <false/>
  <key>keychain-access-groups</key>
  <array>
    <string>com.adguard.probe</string>
  </array>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>com.adguard.probe</string>
  </array>
</dict>
</plist>
